# Copie para `.env` e preencha. NUNCA versione o `.env` real.
# (nome sem ponto porque o Claude Code bloqueia escrita em `.env*` por segurança)
# Regra: credenciais só em variáveis de ambiente (.claude/rules/python-data-rules.md).

# --- LLM / Anthropic ---
ANTHROPIC_API_KEY=

# --- Integrações de dados (ex.: Google Sheets via gspread) ---
GOOGLE_APPLICATION_CREDENTIALS=

# --- Banco de dados ---
DATABASE_URL=

# --- Biblioteca de jogos (dashboard unificado) — ver docs/CREDENTIALS.md ---
# SQLite local; relativo à raiz do projeto se não for absoluto.
DATABASE_PATH=data/games.db

# Steam Web API: gere em https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# SteamID64 da sua conta (ex.: via https://steamid.io)
STEAM_ID64=

# PSN (PSNAWP, não-oficial): token NPSSO obtido logado em https://www.playstation.com
PSN_NPSSO=

# Xbox (OpenXBL, não-oficial): API key gerada em https://xbl.io após login com a conta Xbox
XBOX_OPENXBL_KEY=

# Epic Games (via CLI `legendary`, instalado e autenticado à parte com `legendary auth`)
# só necessário se o binário não estiver no PATH com o nome padrão "legendary"
LEGENDARY_BIN=legendary

# RAWG (opcional): fallback de capa pro import da Nintendo quando a busca da
# eShop não acha o jogo (lançamentos recentes/Switch 2). Chave grátis em
# https://rawg.io/signup -> https://rawg.io/apidocs
RAWG_API_KEY=
