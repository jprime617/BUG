# Copie para `.env` e preencha. NUNCA versione o `.env` real.
# (nome sem ponto porque o Claude Code bloqueia escrita em `.env*` por segurança)
# Regra: credenciais só em variáveis de ambiente (.claude/rules/python-data-rules.md).

# --- Supabase (obrigatórias — auth + banco de dados) ---
# Project URL e chaves em: Supabase > Project Settings > API.
SUPABASE_URL=
# Pública por natureza (RLS protege os dados) — só usada aqui pra login/registro.
SUPABASE_ANON_KEY=
# SECRETA — ignora RLS, uso exclusivo do servidor. Nunca exponha ao client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Configurações dinâmicas (/configuracoes) ---
# Chave mestra pra cifrar credenciais de plataforma (Steam/PSN/Xbox, por
# usuário) guardadas na tabela `settings`. Gere uma com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# --- Biblioteca de jogos — ver docs/CREDENTIALS.md ---
# Steam/PSN/Xbox são pessoais: cada usuário preenche as suas em
# /configuracoes depois de logar — não são lidas daqui em produção. As
# variáveis abaixo só documentam o formato esperado; úteis pra rodar
# `python tasks.py sync <user_id>` localmente sem passar pela tela.
STEAM_API_KEY=
STEAM_ID64=
PSN_NPSSO=
XBOX_OPENXBL_KEY=

# RAWG é a exceção: credencial global (metadado público de jogos, não uma
# conta pessoal) — uma chave só, configurada aqui, vale pra todo mundo.
RAWG_API_KEY=

# Epic Games (via CLI `legendary`, instalado e autenticado à parte com
# `legendary auth`) — só funciona rodando localmente; não existe versão
# hospedada (ver docs/CREDENTIALS.md). Só necessário se o binário não
# estiver no PATH com o nome padrão "legendary".
LEGENDARY_BIN=legendary
